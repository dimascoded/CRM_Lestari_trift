{
  "name": "crm_lestari_thrift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.mjs",
    "db:setup": "prisma migrate dev && node --experimental-strip-types prisma/seed.mjs",
    "user:create": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs scripts/create-user.mjs",
    "test:regression": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs tests/regression.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
